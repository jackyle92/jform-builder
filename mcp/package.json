{
  "name": "@jform/mcp-server",
  "version": "0.2.0",
  "description": "Local MCP server for the JForm Salesforce form builder. Authenticates through the Salesforce CLI.",
  "type": "module",
  "bin": { "jform-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
